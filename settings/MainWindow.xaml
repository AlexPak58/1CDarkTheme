<Window x:Class="ConfiguratorThemeSettings.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xml:lang="ru-RU" Title="Тема 1С" Width="1120" Height="740" MinWidth="880" MinHeight="610" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,10"/></Style>
 </Window.Resources>
 <DockPanel Margin="20,14">
  <DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" Content="Выйти и вернуть цвета" Click="ExitApplication" VerticalAlignment="Top"/><StackPanel><TextBlock Text="Тема 1С" FontSize="27" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}" Text="Работает в фоне. Закрытие окна оставляет утилиту в трее."/></StackPanel></DockPanel>
  <TextBlock DockPanel.Dock="Bottom" x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
  <TabControl>
   <TabItem Header="Общие настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
    <CheckBox x:Name="EnabledBox" Content="Применять тему к открытым и новым сеансам 1С" Checked="EnabledChanged" Unchecked="EnabledChanged"/>
    <CheckBox x:Name="StartupBox" Margin="0,12,0,0" Content="Запускать в трее при входе в Windows" Checked="StartupChanged" Unchecked="StartupChanged"/>
    <TextBlock Text="Файл темы по умолчанию" FontSize="18" Margin="0,20,0,8"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="Применить" Click="ApplyGlobal"/><Button DockPanel.Dock="Right" Content="Обзор…" Click="BrowseGlobal"/><TextBox x:Name="GlobalPresetPath" AutomationProperties.Name="Файл темы по умолчанию"/></DockPanel>
    <TextBlock Style="{StaticResource Hint}" Text="Используется, если нет подходящего исключения. Изменения сохранённого файла применяются к уже открытым сеансам автоматически."/>
    <TextBlock Text="Исключения для баз и платформ" FontSize="18" Margin="0,10,0,8"/>
    <DataGrid x:Name="RulesGrid" Height="152" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="RuleSelected" CanUserAddRows="False">
     <DataGrid.Columns><DataGridTextColumn Header="База" Binding="{Binding BaseId}" Width="2*"/><DataGridTextColumn Header="Платформа" Binding="{Binding Platform}" Width="*"/><DataGridTextColumn Header="Режим" Binding="{Binding Mode}" Width="*"/><DataGridTextColumn Header="Файл пресета" Binding="{Binding PresetFile}" Width="2*"/></DataGrid.Columns>
    </DataGrid>
    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
     <StackPanel><Label Content="База (пусто — все)" Target="{Binding ElementName=RuleBase}"/><TextBox x:Name="RuleBase" AutomationProperties.Name="База исключения" ToolTip="server:сервер\база или file:полный путь"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="8,0"><Label Content="Версия и разрядность" Target="{Binding ElementName=RulePlatform}"/><TextBox x:Name="RulePlatform" AutomationProperties.Name="Платформа исключения" ToolTip="8.3.27.2325-x64. Пусто — все."/></StackPanel>
     <StackPanel Grid.Column="2"><Label Content="Режим"/><ComboBox x:Name="RuleMode" SelectedIndex="0"><ComboBoxItem Content="Все"/><ComboBoxItem Content="Конфигуратор" Tag="Designer"/><ComboBoxItem Content="Предприятие" Tag="Enterprise"/></ComboBox></StackPanel>
    </Grid>
    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Обзор…" Click="BrowseRule"/><TextBox x:Name="RulePresetPath" AutomationProperties.Name="Файл пресета исключения"/></DockPanel>
    <WrapPanel Margin="0,8,0,0"><Button Content="Добавить / заменить" Click="SaveRule"/><Button Content="Вернуть общие настройки" Click="RemoveRule"/><Button Content="Очистить поля" Click="ClearRule"/></WrapPanel>
    <TextBlock Style="{StaticResource Hint}" Text="Приоритет: база и платформа → база → платформа → общая тема. Режим уточняет правило. Для штатных цветов выберите файл native.json."/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Редактор файла пресета"><DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
     <DockPanel><Button DockPanel.Dock="Right" Content="Открыть…" Click="OpenPreset"/><Button DockPanel.Dock="Right" Content="Загрузить" Click="LoadPresetPath"/><TextBox x:Name="PresetPath" AutomationProperties.Name="Путь к файлу пресета"/></DockPanel>
     <DockPanel Margin="0,8,0,10"><Button DockPanel.Dock="Right" Content="Сохранить как…" Click="SavePresetAs"/><Button DockPanel.Dock="Right" Content="Сохранить файл" Click="SavePreset"/><Label Content="Название" Target="{Binding ElementName=PresetName}"/><TextBox x:Name="PresetName" MaxLength="60" AutomationProperties.Name="Название внутри файла"/></DockPanel>
     <TextBlock Style="{StaticResource Hint}" Text="Название — подпись. Применяется файл по указанному пути. Несохранённые изменения не влияют на 1С."/>
    </StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ListBox x:Name="ZoneList" SelectionChanged="ZoneChanged" AutomationProperties.Name="Области оформления" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
     <DockPanel Grid.Column="2"><TextBlock x:Name="ZoneTitle" DockPanel.Dock="Top" FontSize="18" TextWrapping="Wrap"/><TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Цвет #RRGGBB или выбор по образцу."/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ColorRows"/></ScrollViewer></DockPanel>
    </Grid>
   </DockPanel></TabItem>
   <TabItem Header="Открытые сеансы"><DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top"><TextBlock Style="{StaticResource Hint}" Text="Обнаруживаются Конфигуратор и Предприятие. Применение проверено для Конфигуратора 8.3.27.2325 x64; остальные сборки и режимы показаны без подключения DLL."/><TextBlock x:Name="MonitorStatus" TextWrapping="Wrap" Margin="0,0,0,8"/></StackPanel>
    <Expander DockPanel.Dock="Bottom" Header="Дополнительно: запустить тестовый Конфигуратор" Margin="0,10,0,0"><StackPanel Margin="0,8,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Обзор…" Click="BrowsePlatform"/><TextBox x:Name="PlatformPath" AutomationProperties.Name="Путь к 1cv8.exe"/></DockPanel><DockPanel Margin="0,8,0,0"><Button x:Name="LaunchButton" DockPanel.Dock="Right" Content="Запустить" Click="LaunchConfigurator"/><TextBox x:Name="DatabaseTarget" AutomationProperties.Name="Серверная база: сервер\база"/></DockPanel></StackPanel></Expander>
    <DataGrid x:Name="ProcessesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
     <DataGrid.Columns><DataGridTextColumn Header="PID" Binding="{Binding Process.Identity.ProcessId}" Width="65"/><DataGridTextColumn Header="Режим" Binding="{Binding Process.Mode}" Width="90"/><DataGridTextColumn Header="Платформа" Binding="{Binding Process.Platform}" Width="135"/><DataGridTextColumn Header="База" Binding="{Binding Process.BaseId}" Width="*"/><DataGridTextColumn Header="Файл темы" Binding="{Binding PresetPath}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="130"/></DataGrid.Columns>
    </DataGrid>
   </DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
