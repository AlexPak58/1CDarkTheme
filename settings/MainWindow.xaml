<Window x:Class="ConfiguratorThemeSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="ru-RU"
        Title="Тема Конфигуратора 1С"
        Width="875" Height="735" MinWidth="735" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Framed" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="112"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Тема Конфигуратора 1С" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,14" Text="Настройте цвета и запустите новый Конфигуратор • 8.3.27.2130 x64"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Margin="0,0,9,0" Content="Пресет" Target="{Binding ElementName=PresetBox}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="PresetBox" DisplayMemberPath="Name"
                      SelectionChanged="PresetChanged" AutomationProperties.Name="Пресет"/>
            <Button Grid.Column="2" x:Name="SaveButton" Margin="8,0,0,0" Content="Сохранить как…" Click="SavePreset"/>
            <Button Grid.Column="3" x:Name="DeleteButton" Margin="8,0,0,0" Content="Удалить" Click="DeletePreset"
                    AutomationProperties.Name="Удалить выбранный пресет"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Framed}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Области оформления"/>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,8" Text="Отметьте области, где нужна тема."/>
                    <ListBox x:Name="ZoneList" SelectionChanged="ZoneChanged" AutomationProperties.Name="Области оформления"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Framed}">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="ZoneTitle" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,10" Text="Введите RGB в формате #RRGGBB или нажмите на образец." TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ColorRows" Margin="0,0,10,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="3" Margin="0,0,0,6" Style="{StaticResource SectionTitle}" Text="Запуск"/>
            <Label Grid.Row="1" Margin="0,0,10,0" Content="Путь к 1cv8.exe" Target="{Binding ElementName=PlatformPath}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PlatformPath" AutomationProperties.Name="Путь к 1cv8.exe"/>
            <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Content="Обзор…" Click="BrowsePlatform"
                    AutomationProperties.Name="Выбрать 1cv8.exe"/>
            <Label Grid.Row="2" Margin="0,5,10,0" Content="База 1С" Target="{Binding ElementName=DatabaseTarget}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                     x:Name="DatabaseTarget" ToolTip="Сервер\база или полный путь к каталогу файловой базы" AutomationProperties.Name="База 1С: сервер\база"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,15,0">
                <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="Для выпадающих меню можно настроить фон, полосу значков, текст и горячие клавиши. Цвет подсветки пункта задаёт платформа. Списки «Назначение расширения» и «Основной режим запуска» включаются отдельно."/>
            </StackPanel>
            <Button x:Name="LaunchButton" Grid.Column="1" VerticalAlignment="Center" Padding="14,8"
                    Content="Запустить Конфигуратор" Click="LaunchConfigurator"/>
        </Grid>
    </Grid>
</Window>
